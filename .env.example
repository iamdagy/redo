# Public URL of the site (share links and canonical URL). Read at build time.
SITE_URL=https://redoapp.dev

# 1 = every visitor uses their own Comfy API key (recommended for a public server).
OEV_REQUIRE_USER_KEY=1

# Optional: the server's own Comfy API key, for private use only. Leave empty on a public server.
# COMFY_API_KEY=

# Optional: how many Smooth Cut jobs may run at once (they use the server's CPU).
# OEV_MAX_SMOOTHCUTS=2

# Optional: path to the whisper.cpp model used to find filler words in Smooth Cut.
# WHISPER_MODEL=/home/redo/.cache/whisper-cpp/ggml-large-v3-turbo.bin
