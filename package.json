{
  "name": "open-edit-video",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source Edit Video: Reframe, Remove, Smooth Cut, Upscale and Remove background with open-weight models on Comfy Cloud.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "workflows": "python3 scripts/build_workflows.py",
    "test": "node --test --no-warnings test/*.test.ts",
    "run-tool": "node --no-warnings scripts/run-tool.ts",
    "smooth-cut": "node --no-warnings scripts/smooth-cut.ts"
  },
  "dependencies": {
    "@comfyorg/sdk": "0.5.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
