{
  "in_frame_a": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "frame_a.png"
    },
    "_meta": {
      "title": "IN:frame A"
    }
  },
  "in_frame_b": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "frame_b.png"
    },
    "_meta": {
      "title": "IN:frame B"
    }
  },
  "in_size_a": {
    "class_type": "ResizeImageMaskNode",
    "inputs": {
      "input": [
        "in_frame_a",
        0
      ],
      "resize_type": "scale dimensions",
      "resize_type.width": 960,
      "resize_type.height": 544,
      "resize_type.crop": "center",
      "scale_method": "lanczos"
    },
    "_meta": {
      "title": "IN:work size A"
    }
  },
  "in_size_b": {
    "class_type": "ResizeImageMaskNode",
    "inputs": {
      "input": [
        "in_frame_b",
        0
      ],
      "resize_type": "scale dimensions",
      "resize_type.width": 960,
      "resize_type.height": 544,
      "resize_type.crop": "center",
      "scale_method": "lanczos"
    },
    "_meta": {
      "title": "IN:work size B"
    }
  },
  "prep_a": {
    "class_type": "LTXVPreprocess",
    "inputs": {
      "image": [
        "in_size_a",
        0
      ],
      "img_compression": 25
    }
  },
  "prep_b": {
    "class_type": "LTXVPreprocess",
    "inputs": {
      "image": [
        "in_size_b",
        0
      ],
      "img_compression": 25
    }
  },
  "in_len": {
    "class_type": "PrimitiveInt",
    "inputs": {
      "value": 17
    },
    "_meta": {
      "title": "IN:bridge frames (8n+1)"
    }
  },
  "in_fps": {
    "class_type": "PrimitiveFloat",
    "inputs": {
      "value": 25.0
    },
    "_meta": {
      "title": "IN:fps"
    }
  },
  "ckpt": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "ltx-2.3-22b-distilled-fp8.safetensors"
    }
  },
  "audio_vae": {
    "class_type": "LTXVAudioVAELoader",
    "inputs": {
      "ckpt_name": "ltx-2.3-22b-distilled-fp8.safetensors"
    }
  },
  "text_enc": {
    "class_type": "LTXAVTextEncoderLoader",
    "inputs": {
      "text_encoder": "gemma_3_12B_it_fp4_mixed.safetensors",
      "ckpt_name": "ltx-2.3-22b-distilled-fp8.safetensors",
      "device": "default"
    }
  },
  "p_prompt": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "Static camera. The same person keeps the same pose with a subtle, natural head movement. Mouth closed.",
      "clip": [
        "text_enc",
        0
      ]
    },
    "_meta": {
      "title": "IN:prompt"
    }
  },
  "p_negative": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "blurry, out of focus, low contrast, washed out colors, noise, flicker, warping, distorted faces, extra limbs, text, watermark, borders, black bars",
      "clip": [
        "text_enc",
        0
      ]
    },
    "_meta": {
      "title": "IN:negative"
    }
  },
  "cond": {
    "class_type": "LTXVConditioning",
    "inputs": {
      "positive": [
        "p_prompt",
        0
      ],
      "negative": [
        "p_negative",
        0
      ],
      "frame_rate": [
        "in_fps",
        0
      ]
    }
  },
  "in_work": {
    "class_type": "EmptyLTXVLatentVideo",
    "inputs": {
      "width": 960,
      "height": 544,
      "length": [
        "in_len",
        0
      ],
      "batch_size": 1
    },
    "_meta": {
      "title": "IN:work size"
    }
  },
  "p_key0": {
    "class_type": "LTXVAddGuide",
    "inputs": {
      "positive": [
        "cond",
        0
      ],
      "negative": [
        "cond",
        1
      ],
      "vae": [
        "ckpt",
        2
      ],
      "latent": [
        "in_work",
        0
      ],
      "image": [
        "prep_a",
        0
      ],
      "frame_idx": 0,
      "strength": 1.0
    },
    "_meta": {
      "title": "IN:keyframe 0 (preset)"
    }
  },
  "p_key1": {
    "class_type": "LTXVAddGuide",
    "inputs": {
      "positive": [
        "p_key0",
        0
      ],
      "negative": [
        "p_key0",
        1
      ],
      "vae": [
        "ckpt",
        2
      ],
      "latent": [
        "p_key0",
        2
      ],
      "image": [
        "prep_b",
        0
      ],
      "frame_idx": -1,
      "strength": 1.0
    },
    "_meta": {
      "title": "IN:keyframe 1 (preset)"
    }
  },
  "audio_lat": {
    "class_type": "LTXVEmptyLatentAudio",
    "inputs": {
      "frames_number": [
        "in_len",
        0
      ],
      "frame_rate": [
        "in_fps",
        0
      ],
      "batch_size": 1,
      "audio_vae": [
        "audio_vae",
        0
      ]
    }
  },
  "av": {
    "class_type": "LTXVConcatAVLatent",
    "inputs": {
      "video_latent": [
        "p_key1",
        2
      ],
      "audio_latent": [
        "audio_lat",
        0
      ]
    }
  },
  "p_sampler": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "ckpt",
        0
      ],
      "seed": 42,
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "euler_ancestral",
      "scheduler": "linear_quadratic",
      "positive": [
        "p_key1",
        0
      ],
      "negative": [
        "p_key1",
        1
      ],
      "latent_image": [
        "av",
        0
      ],
      "denoise": 1.0
    },
    "_meta": {
      "title": "IN:sampler (seed, steps)"
    }
  },
  "split": {
    "class_type": "LTXVSeparateAVLatent",
    "inputs": {
      "av_latent": [
        "p_sampler",
        0
      ]
    }
  },
  "crop_guides": {
    "class_type": "LTXVCropGuides",
    "inputs": {
      "positive": [
        "p_key1",
        0
      ],
      "negative": [
        "p_key1",
        1
      ],
      "latent": [
        "split",
        0
      ]
    }
  },
  "decode": {
    "class_type": "VAEDecodeTiled",
    "inputs": {
      "samples": [
        "crop_guides",
        2
      ],
      "vae": [
        "ckpt",
        2
      ],
      "tile_size": 768,
      "overlap": 64,
      "temporal_size": 4096,
      "temporal_overlap": 64
    }
  },
  "in_out": {
    "class_type": "ResizeImageMaskNode",
    "inputs": {
      "input": [
        "decode",
        0
      ],
      "resize_type": "scale dimensions",
      "resize_type.width": 1920,
      "resize_type.height": 1080,
      "resize_type.crop": "disabled",
      "scale_method": "lanczos"
    },
    "_meta": {
      "title": "IN:output size"
    }
  },
  "out_video_mux": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "in_out",
        0
      ],
      "fps": [
        "in_fps",
        0
      ]
    }
  },
  "out_video": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "out_video_mux",
        0
      ],
      "filename_prefix": "open-edit-video/bridge",
      "format": "mp4",
      "format.codec": "h264",
      "format.codec.encoding": "re-encode",
      "format.codec.encoding.crf": 16
    },
    "_meta": {
      "title": "OUT:video"
    }
  }
}
